@{
    ViewData["Title"] = "Pago pendiente";
    Layout = "_Layout";
}

<div class="container-xxl py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 text-center p-5">
                <div class="mb-4">
                    <div class="ej-status-icon pending mx-auto">
                        <i class="bi bi-clock-history"></i>
                    </div>
                </div>
                <h1 class="h3 fw-bold text-warning mb-2">Pago pendiente</h1>
                <p class="text-muted mb-4">
                    Tu pago está siendo procesado. Podés pagarlo en efectivo en Rapipago o PagoFácil
                    con el cupón que Mercado Pago te envió por email.
                </p>
                @if (ViewBag.NumeroOperacion != "—")
                {
                    <p class="small text-muted mb-4">N° de operación: @ViewBag.NumeroOperacion</p>
                }
                <a href="/" class="btn btn-primary btn-lg w-100">
                    <i class="bi bi-grid me-2"></i>Volver al catálogo
                </a>
            </div>
        </div>
    </div>
</div>
