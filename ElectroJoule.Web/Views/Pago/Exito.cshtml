@{
    ViewData["Title"] = "¡Pago exitoso!";
    Layout = "_Layout";
}

<div class="container-xxl py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 text-center p-5">
                <div class="mb-4">
                    <div class="ej-status-icon success mx-auto">
                        <i class="bi bi-check-lg"></i>
                    </div>
                </div>
                <h1 class="h3 fw-bold text-success mb-2">¡Pago exitoso!</h1>
                <p class="text-muted mb-4">
                    Tu compra fue procesada correctamente. Recibirás un email con la confirmación.
                </p>
                <div class="card bg-light border-0 rounded-3 p-3 mb-4 text-start">
                    <div class="row g-2 small">
                        <div class="col-6 text-muted">N° de operación:</div>
                        <div class="col-6 fw-semibold">@ViewBag.NumeroOperacion</div>
                        <div class="col-6 text-muted">Referencia:</div>
                        <div class="col-6 fw-semibold text-truncate">@ViewBag.Referencia</div>
                    </div>
                </div>
                <a href="/" class="btn btn-primary btn-lg w-100">
                    <i class="bi bi-grid me-2"></i>Seguir comprando
                </a>
            </div>
        </div>
    </div>
</div>
