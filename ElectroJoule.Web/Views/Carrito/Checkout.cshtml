@model CheckoutViewModel
@{
    ViewData["Title"] = "Finalizar compra";
}

<div class="container-xxl py-4">
    <h1 class="h3 fw-bold mb-4"><i class="bi bi-lock me-2 text-primary"></i>Finalizar compra</h1>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.Error
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Formulario de datos -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header ej-card-header-primary border-0 rounded-top-3">
                    <h5 class="mb-0 text-white fw-semibold">
                        <i class="bi bi-person me-2"></i>Datos del comprador
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Pago" asp-action="Procesar" method="post">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-semibold">Nombre completo <span class="text-danger">*</span></label>
                                <input type="text" name="Nombre" class="form-control" required
                                       placeholder="Ej: Juan Pérez" value="@Model.Nombre" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                                <input type="email" name="Email" class="form-control" required
                                       placeholder="tu@email.com" value="@Model.Email" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Teléfono</label>
                                <input type="tel" name="Telefono" class="form-control"
                                       placeholder="Ej: 11 1234-5678" value="@Model.Telefono" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">DNI <span class="text-danger">*</span></label>
                                <input type="text" name="Dni" class="form-control" required
                                       placeholder="Ej: 30123456" value="@Model.Dni" />
                            </div>
                        </div>

                        <hr class="my-4" />
                        <h6 class="fw-semibold mb-3">
                            <i class="bi bi-credit-card me-2 text-primary"></i>Método de pago
                        </h6>
                        <div class="card bg-light border-0 p-3 mb-4">
                            <div class="d-flex align-items-center gap-3">
                                <img src="https://http2.mlstatic.com/frontend-assets/payment-component/logos/mp_logo.svg"
                                     alt="Mercado Pago" height="32" />
                                <div>
                                    <div class="fw-semibold">Mercado Pago</div>
                                    <small class="text-muted">Tarjeta de crédito/débito, efectivo (Rapipago/PagoFácil), transferencia bancaria, Mercado Crédito.</small>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            <i class="bi bi-shield-check me-2"></i>Ir a pagar con Mercado Pago
                        </button>
                        <p class="text-center text-muted small mt-2">
                            <i class="bi bi-lock-fill me-1"></i>Serás redirigido al sitio seguro de Mercado Pago
                        </p>
                    </form>
                </div>
            </div>
        </div>

        <!-- Resumen -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-light border-0 rounded-top-3">
                    <h5 class="mb-0 fw-semibold">Resumen del pedido</h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var item in Model.Carrito.Items)
                        {
                            <li class="list-group-item px-3 py-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@item.ImagenUrl" alt="" style="width:40px;height:28px;object-fit:cover;" class="rounded-1" />
                                        <div>
                                            <div class="small fw-semibold">@item.Nombre</div>
                                            <div class="text-muted" style="font-size:0.75rem;">x@item.Cantidad · $@item.PrecioUnit.ToString("N0") c/u</div>
                                        </div>
                                    </div>
                                    <span class="fw-semibold small">$@item.Subtotal.ToString("N0")</span>
                                </div>
                            </li>
                        }
                    </ul>
                    <div class="p-3">
                        <div class="d-flex justify-content-between fw-bold fs-5">
                            <span>Total</span>
                            <span class="ej-precio">$@Model.Carrito.Total.ToString("N0")</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="mt-3 text-center">
                <a href="/Carrito" class="text-muted small text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i>Volver al carrito
                </a>
            </div>
        </div>
    </div>
</div>
