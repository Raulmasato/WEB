@model Carrito
@{
    ViewData["Title"] = "Mi Carrito";
}

<div class="container-xxl py-4">
    <h1 class="h3 fw-bold mb-4"><i class="bi bi-cart3 me-2 text-primary"></i>Mi Carrito</h1>

    @if (!Model.Items.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x display-2 text-muted"></i>
            <p class="mt-3 fs-5 text-muted">Tu carrito está vacío</p>
            <a href="/" class="btn btn-primary mt-2 px-4">
                <i class="bi bi-grid me-2"></i>Ver catálogo
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Items -->
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">Producto</th>
                                        <th class="text-center">Precio</th>
                                        <th class="text-center" style="width:130px">Cantidad</th>
                                        <th class="text-end">Subtotal</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td class="ps-3">
                                                <div class="d-flex align-items-center gap-3">
                                                    <img src="@item.ImagenUrl" alt="@item.Nombre"
                                                         class="rounded-2 shadow-sm"
                                                         style="width:60px;height:42px;object-fit:cover;" />
                                                    <span class="fw-semibold small">@item.Nombre</span>
                                                </div>
                                            </td>
                                            <td class="text-center text-muted">${@item.PrecioUnit.ToString("N0")}</td>
                                            <td class="text-center">
                                                <form asp-action="Actualizar" method="post" class="d-flex justify-content-center gap-1">
                                                    <input type="hidden" name="productoId" value="@item.ProductoId" />
                                                    <input type="number" name="cantidad" value="@item.Cantidad"
                                                           min="1" max="99" class="form-control form-control-sm text-center"
                                                           style="width:60px"
                                                           onchange="this.form.submit()" />
                                                </form>
                                            </td>
                                            <td class="text-end fw-bold ej-precio-tabla">
                                                $@item.Subtotal.ToString("N0")
                                            </td>
                                            <td class="text-center">
                                                <form asp-action="Quitar" method="post">
                                                    <input type="hidden" name="productoId" value="@item.ProductoId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger border-0"
                                                            title="Quitar" onclick="return confirm('¿Quitar este producto?')">
                                                        <i class="bi bi-trash3"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="mt-2 d-flex justify-content-between">
                    <a href="/" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i>Seguir comprando
                    </a>
                    <form asp-action="Vaciar" method="post">
                        <button type="submit" class="btn btn-outline-danger btn-sm"
                                onclick="return confirm('¿Vaciar el carrito?')">
                            <i class="bi bi-trash3 me-1"></i>Vaciar carrito
                        </button>
                    </form>
                </div>
            </div>

            <!-- Resumen -->
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 rounded-3 sticky-top" style="top: 80px;">
                    <div class="card-header ej-card-header-primary border-0 rounded-top-3">
                        <h5 class="mb-0 text-white fw-semibold">
                            <i class="bi bi-receipt me-2"></i>Resumen del pedido
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2 text-muted small">
                            <span>Subtotal (@Model.CantidadTotal productos)</span>
                            <span>$@Model.Total.ToString("N0")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 text-muted small">
                            <span>Envío</span>
                            <span class="text-success fw-semibold">A calcular</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between fw-bold fs-5 mb-4">
                            <span>Total</span>
                            <span class="ej-precio">$@Model.Total.ToString("N0")</span>
                        </div>
                        <a href="/Carrito/Checkout" class="btn btn-primary btn-lg w-100">
                            <i class="bi bi-lock me-2"></i>Finalizar compra
                        </a>
                        <div class="text-center mt-3">
                            <img src="https://http2.mlstatic.com/frontend-assets/payment-component/logos/mp_logo.svg"
                                 alt="Mercado Pago" height="24" class="opacity-75 me-1" />
                            <small class="text-muted">Pago seguro con Mercado Pago</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
