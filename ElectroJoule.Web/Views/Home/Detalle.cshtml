@model Producto
@{
    ViewData["Title"] = Model.Nombre;
}

<div class="container-xxl py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Catálogo</a></li>
            <li class="breadcrumb-item"><a href="/?Categoria=@Uri.EscapeDataString(Model.Categoria)" class="text-decoration-none">@Model.Categoria</a></li>
            <li class="breadcrumb-item active">@Model.Nombre</li>
        </ol>
    </nav>

    <div class="row g-5">
        <!-- Imagen -->
        <div class="col-md-5">
            <div class="ej-detalle-img-wrap">
                <img src="@Model.ImagenUrl" class="img-fluid rounded-3 shadow" alt="@Model.Nombre" />
            </div>
            <div class="d-flex gap-2 mt-3">
                <span class="badge bg-primary px-3 py-2 rounded-pill fs-6">@Model.Categoria</span>
                <span class="badge bg-secondary px-3 py-2 rounded-pill fs-6">@Model.Marca</span>
            </div>
        </div>

        <!-- Info -->
        <div class="col-md-7">
            <h1 class="h2 fw-bold mb-2">@Model.Nombre</h1>
            <p class="text-muted mb-4">@Model.Descripcion</p>

            <div class="ej-precio-detalle mb-3">
                $@Model.Precio.ToString("N0")
                <span class="fs-6 text-muted fw-normal ms-2">ARS</span>
            </div>

            @{
                var stockClass = Model.Stock > 10 ? "success" : Model.Stock > 0 ? "warning" : "danger";
                var stockTexto = Model.Stock > 10 ? $"En stock ({Model.Stock} unidades)" : Model.Stock > 0 ? $"¡Últimas {Model.Stock} unidades!" : "Sin stock";
            }
            <div class="alert alert-@stockClass d-inline-flex align-items-center gap-2 mb-4 py-2 px-3">
                <i class="bi bi-@(Model.Stock > 0 ? "check-circle-fill" : "x-circle-fill")"></i>
                <span class="fw-semibold">@stockTexto</span>
            </div>

            @if (Model.Stock > 0)
            {
                <form asp-controller="Carrito" asp-action="Agregar" method="post" class="d-flex gap-3 align-items-center mb-4">
                    <input type="hidden" name="productoId" value="@Model.Id" />
                    <div class="input-group" style="max-width: 130px;">
                        <button type="button" class="btn btn-outline-secondary" onclick="cambiarCantidad(-1)">−</button>
                        <input type="number" name="cantidad" id="inputCantidad" class="form-control text-center"
                               value="1" min="1" max="@Model.Stock" />
                        <button type="button" class="btn btn-outline-secondary" onclick="cambiarCantidad(1)">+</button>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg px-4">
                        <i class="bi bi-cart-plus me-2"></i>Agregar al carrito
                    </button>
                </form>
            }

            <div class="card bg-light border-0 rounded-3 p-3 mt-2">
                <div class="row g-3 text-center">
                    <div class="col-4">
                        <i class="bi bi-truck text-primary fs-4 d-block mb-1"></i>
                        <small class="text-muted">Envío a todo el país</small>
                    </div>
                    <div class="col-4">
                        <i class="bi bi-shield-check text-primary fs-4 d-block mb-1"></i>
                        <small class="text-muted">Pago 100% seguro</small>
                    </div>
                    <div class="col-4">
                        <i class="bi bi-arrow-counterclockwise text-primary fs-4 d-block mb-1"></i>
                        <small class="text-muted">Devoluciones</small>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <img src="https://http2.mlstatic.com/frontend-assets/payment-component/logos/mp_logo.svg"
                     alt="Mercado Pago" height="28" class="opacity-75" />
                <small class="text-muted ms-2">Pagás con Mercado Pago</small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function cambiarCantidad(delta) {
    const inp = document.getElementById('inputCantidad');
    const val = parseInt(inp.value) + delta;
    inp.value = Math.max(1, Math.min(parseInt(inp.max), val));
}
</script>
}
