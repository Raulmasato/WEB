@{
    ViewData["Title"] = "Catálogo";
    var productos = (List<Producto>)ViewBag.Productos;
    var categorias = (List<string>)ViewBag.Categorias;
    var marcas = (List<string>)ViewBag.Marcas;
    var filtro = (FiltroProducto?)ViewBag.Filtro ?? new FiltroProducto();
}

<!-- Hero Banner -->
<section class="ej-hero">
    <div class="container-xxl py-5">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <span class="badge bg-warning text-dark mb-3 px-3 py-2 rounded-pill">
                    <i class="bi bi-lightning-charge-fill me-1"></i>¡Nuevos componentes!
                </span>
                <h1 class="display-5 fw-bold text-white mb-3">
                    Todo para tus<br/><span class="ej-hero-accent">proyectos electrónicos</span>
                </h1>
                <p class="lead text-white-50 mb-4">
                    Arduino, ESP32, Raspberry Pi, sensores, módulos y más.<br/>
                    Enviamos a todo el país. Pagos con Mercado Pago.
                </p>
                <a href="#catalogo" class="btn btn-warning btn-lg px-4 me-2">
                    <i class="bi bi-grid me-2"></i>Ver catálogo
                </a>
            </div>
            <div class="col-lg-6 d-none d-lg-flex justify-content-end">
                <div class="ej-hero-stats d-flex gap-4">
                    <div class="text-center">
                        <div class="fs-2 fw-bold text-warning">+200</div>
                        <div class="text-white-50 small">Productos</div>
                    </div>
                    <div class="text-center">
                        <div class="fs-2 fw-bold text-warning">24h</div>
                        <div class="text-white-50 small">Despacho</div>
                    </div>
                    <div class="text-center">
                        <div class="fs-2 fw-bold text-warning">MP</div>
                        <div class="text-white-50 small">Pago seguro</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Barra de Filtros -->
<section id="catalogo" class="ej-filtros-bar py-3 sticky-top">
    <div class="container-xxl">
        <form method="get" action="/" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="Buscar" class="form-control border-start-0 ps-0"
                           placeholder="Buscar componente..." value="@filtro.Buscar" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="Categoria" class="form-select">
                    <option value="">Todas las categorías</option>
                    @foreach (var cat in categorias)
                    {
                        <option value="@cat" selected="@(filtro.Categoria == cat ? "selected" : null)">@cat</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="Marca" class="form-select">
                    <option value="">Todas las marcas</option>
                    @foreach (var marca in marcas)
                    {
                        <option value="@marca" selected="@(filtro.Marca == marca ? "selected" : null)">@marca</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">
                        <i class="bi bi-funnel me-1"></i>Filtrar
                    </button>
                    <a href="/" class="btn btn-outline-secondary" title="Limpiar">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>
</section>

<!-- Grid de Productos -->
<section class="py-4">
    <div class="container-xxl">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="fs-5 fw-semibold mb-0">
                @if (!string.IsNullOrEmpty(filtro.Buscar) || !string.IsNullOrEmpty(filtro.Categoria) || !string.IsNullOrEmpty(filtro.Marca))
                {
                    <span class="text-muted">Resultados: </span>
                }
                <span class="badge bg-primary-subtle text-primary rounded-pill">@productos.Count productos</span>
            </h2>
        </div>

        @if (!productos.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-search display-3 text-muted"></i>
                <p class="mt-3 text-muted fs-5">No encontramos productos con esos filtros.</p>
                <a href="/" class="btn btn-primary mt-2">Ver todo el catálogo</a>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4">
                @foreach (var p in productos)
                {
                    <div class="col">
                        <div class="card ej-producto-card h-100">
                            <a href="/Home/Detalle/@p.Slug" class="text-decoration-none">
                                <div class="ej-card-img-wrap">
                                    <img src="@p.ImagenUrl" class="card-img-top" alt="@p.Nombre" loading="lazy" />
                                    <span class="badge bg-primary ej-badge-cat">@p.Categoria</span>
                                </div>
                            </a>
                            <div class="card-body d-flex flex-column">
                                <p class="ej-marca-label mb-1">@p.Marca</p>
                                <a href="/Home/Detalle/@p.Slug" class="text-decoration-none text-dark">
                                    <h5 class="card-title fs-6 fw-semibold mb-2">@p.Nombre</h5>
                                </a>
                                <p class="card-text text-muted small ej-descripcion-truncada flex-grow-1">
                                    @p.Descripcion
                                </p>
                                <div class="mt-auto pt-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="ej-precio fs-5 fw-bold">$@p.Precio.ToString("N0")</span>
                                        <span class="badge @(p.Stock > 10 ? "bg-success-subtle text-success" : p.Stock > 0 ? "bg-warning-subtle text-warning" : "bg-danger-subtle text-danger") small">
                                            @(p.Stock > 10 ? "En stock" : p.Stock > 0 ? $"Últimas {p.Stock}" : "Sin stock")
                                        </span>
                                    </div>
                                    <form asp-controller="Carrito" asp-action="Agregar" method="post" class="agregar-form">
                                        <input type="hidden" name="productoId" value="@p.Id" />
                                        <input type="hidden" name="cantidad" value="1" />
                                        <button type="submit" class="btn btn-primary btn-sm w-100 @(p.Stock == 0 ? "disabled" : "")"
                                                @(p.Stock == 0 ? "disabled" : "")>
                                            <i class="bi bi-cart-plus me-1"></i>Agregar al carrito
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@section Scripts {
<script>
document.querySelectorAll('.agregar-form').forEach(form => {
    form.addEventListener('submit', async function(e) {
        e.preventDefault();
        const btn = form.querySelector('button[type=submit]');
        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Agregando...';
        try {
            const fd = new FormData(form);
            const res = await fetch(form.action, { method: 'POST', body: fd,
                headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            const data = await res.json();
            if (data.ok) {
                btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>¡Agregado!';
                btn.classList.replace('btn-primary', 'btn-success');
                const badge = document.querySelector('.navbar .badge');
                if (badge) badge.textContent = data.total;
                else {
                    const carritoBtn = document.querySelector('a[href="/Carrito"]');
                    carritoBtn.insertAdjacentHTML('beforeend',
                        `<span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning text-dark">${data.total}</span>`);
                }
                setTimeout(() => {
                    btn.innerHTML = originalHtml;
                    btn.classList.replace('btn-success', 'btn-primary');
                    btn.disabled = false;
                }, 1500);
            }
        } catch { btn.innerHTML = originalHtml; btn.disabled = false; }
    });
});
</script>
}
